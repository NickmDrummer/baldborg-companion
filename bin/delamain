#!/usr/bin/env node
/**
 * Control channel for the Delamain overlay.
 *
 * Wayland does not allow an application to register global hotkeys reliably
 * (Electron's globalShortcut only works under X11/XWayland), so the compositor
 * owns the keybindings and calls this script instead:
 *
 *   bind = SUPER SHIFT, D, exec, /path/to/DelamainCompanion/bin/delamain toggle
 *   bind = SUPER SHIFT, M, exec, /path/to/DelamainCompanion/bin/delamain mute
 *
 * Commands: toggle | open | close | mute | show | hide | quit
 */

import { connect } from "node:net";
import { homedir } from "node:os";
import { join } from "node:path";

const SOCKET = join(homedir(), ".config", "delamain", "control.sock");
const command = process.argv[2];

const VALID = new Set(["toggle", "open", "close", "mute", "forget", "show", "hide", "quit", "capture"]);

if (!command || !VALID.has(command)) {
  console.error(`usage: delamain <${[...VALID].join("|")}>`);
  process.exit(2);
}

const socket = connect(SOCKET, () => {
  socket.write(`${command}\n`);
  socket.end();
});

socket.on("error", (error) => {
  console.error(`delamain: cannot reach the overlay (${error.code}) at ${SOCKET}`);
  process.exit(1);
});

socket.on("close", () => process.exit(0));
