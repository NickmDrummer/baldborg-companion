#!/usr/bin/env node
/**
 * Control channel for the Baldborg overlay.
 *
 * Wayland does not allow an application to register global hotkeys reliably
 * (Electron's globalShortcut only works under X11/XWayland), so the compositor
 * owns the keybindings and calls this script instead:
 *
 *   bind = SUPER SHIFT, D, exec, /path/to/BaldborgCompanion/bin/baldborg toggle
 *   bind = SUPER SHIFT, M, exec, /path/to/BaldborgCompanion/bin/baldborg mute
 *
 * Commands: toggle | open | close | mute | show | hide | quit | listen start|stop
 *           doctor (read-only health check)
 */

import { spawn, spawnSync } from "node:child_process";
import { connect } from "node:net";
import { homedir } from "node:os";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

const ROOT = join(dirname(fileURLToPath(import.meta.url)), "..");
const SOCKET = join(homedir(), ".config", "baldborg", "control.sock");
const [command, ...rest] = process.argv.slice(2);

if (command === "doctor") {
  const result = spawnSync(process.execPath, [join(ROOT, "scripts", "doctor.mjs")], {
    stdio: "inherit",
  });
  process.exit(result.status ?? 1);
}
if (command === "start") {
  const child = spawn(join(ROOT, "bin", "baldborg-start"), [], {
    detached: true,
    stdio: "ignore",
  });
  child.unref();
  process.exit(0);
}
const payload = ["announce", "language", "listen"].includes(command)
  ? `${command} ${rest.join(" ").trim()}`
  : command;

const VALID = new Set([
  "start",
  "toggle",
  "open",
  "close",
  "mute",
  "forget",
  "speak",
  "glitch",
  "beat",
  "theme",
  "announce",
  "language",
  "listen",
  "status",
  "show",
  "hide",
  "quit",
  "capture",
  "drag-start",
  "drag-end",
  "doctor",
]);

if (!command || !VALID.has(command)) {
  console.error(`usage: baldborg <${[...VALID].join("|")}>`);
  process.exit(2);
}

const socket = connect(SOCKET, () => {
  socket.write(`${payload}\n`);
  socket.end();
});

socket.on("error", (error) => {
  console.error(`baldborg: cannot reach the overlay (${error.code}) at ${SOCKET}`);
  process.exit(1);
});

if (command === "status" || command === "beat") {
  let data = "";
  socket.on("data", (chunk) => {
    data += chunk.toString();
  });
  socket.on("close", () => {
    process.stdout.write(data);
    process.exit(0);
  });
} else {
  socket.on("close", () => process.exit(0));
}
